{
  "name": "lokijs",
  "version": "1.5.12",
  "description": "Fast document oriented javascript in-memory database",
  "homepage": "https://techfort.github.io/LokiJS/",
  "main": "src/lokijs.js",
  "module": "src/lokijs.mjs",
  "types": "types/lokijs.d.ts",
  "exports": {
    ".": {
      "types": "./types/lokijs.d.ts",
      "import": "./src/lokijs.mjs",
      "require": "./src/lokijs.js",
      "default": "./src/lokijs.js"
    },
    "./src/*.js": "./src/*.js",
    "./src/*.mjs": "./src/*.mjs",
    "./src/*": "./src/*.js",
    "./build/*.js": "./build/*.js",
    "./build/*": "./build/*.js",
    "./package.json": "./package.json"
  },
  "directories": {
    "example": "examples"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/techfort/LokiJS.git"
  },
  "keywords": [
    "javascript",
    "document-oriented",
    "mmdb",
    "json",
    "nosql",
    "lokijs",
    "in-memory",
    "indexeddb"
  ],
  "scripts": {
    "lint": "eslint src spec",
    "pretest": "npm run lint",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:coverage": "vitest run --project unit --coverage",
    "build:lokijs": "terser src/lokijs.js --compress --mangle -o build/lokijs.min.js",
    "build:indexedAdapter": "terser src/loki-indexed-adapter.js --compress --mangle -o build/loki-indexed-adapter.min.js",
    "build": "npm run build:lokijs && npm run build:indexedAdapter",
    "prepack": "npm run build",
    "clean": "rimraf build coverage",
    "jsdoc": "jsdoc -c docs-conf.json",
    "benchmark": "node benchmark/benchmark"
  },
  "author": "Joe Minichino <joe.minichino@gmail.com>",
  "contributors": [
    {
      "name": "Dave",
      "email": "github@obeliskos.com"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/techfort/LokiJS/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/browser": "^5.0.2",
    "@vitest/browser-playwright": "^5.0.2",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jsdoc": "^4.0.5",
    "playwright": "^1.63.0",
    "rimraf": "^6.1.3",
    "terser": "^5.51.2",
    "vitest": "^5.0.2"
  }
}
